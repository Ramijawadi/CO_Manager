MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=co_management
PORT=3001
# Persistent Node hosting: exact browser-facing origins allowed for Socket.IO.
# SOCKET_ALLOWED_ORIGINS=https://your-app.example.com
# Optional public URL of a separate persistent Socket.IO service (also set in Vercel API env).
# SOCKET_SERVER_URL=https://notifications.example.com
# Optional client override; normally the ticket API supplies SOCKET_SERVER_URL.
# VITE_SOCKET_URL=
# Optional: require admin approval before new employee accounts can log in.
# EMPLOYEE_APPROVAL_REQUIRED=true
VITE_API_URL=/api
# Production only: set NODE_ENV=production and the public HTTPS origin.
# APP_ORIGIN=https://your-app.example.com
# Vercel: add MONGODB_URI and MONGODB_DB_NAME in Project Settings, then redeploy.
# APP_ORIGIN is optional on Vercel; leave unset to support Preview domains.
# Never prefix MongoDB credentials with VITE_.
# Optional public beta login defaults. Anyone viewing the app can read these.
VITE_BETA_LOGIN_EMAIL=
VITE_BETA_LOGIN_PASSWORD=
